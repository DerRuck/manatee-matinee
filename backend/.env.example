# Copy to .env and fill in real values for local development.
# In Cloud Run, these come from Secret Manager + env vars on the service.

# --- App ---
ENV=local
LOG_LEVEL=INFO

# --- Google Cloud ---
GCP_PROJECT_ID=chawq-v1-local
GCP_LOCATION=us-central1

# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
CLAUDE_MODEL=claude-sonnet-4-6

# --- GoHighLevel (Private Integration Token) ---
GHL_PIT=pit-REPLACE_ME
GHL_LOCATION_ID=REPLACE_ME
GHL_WEBHOOK_SECRET=REPLACE_ME

# --- Google Drive ---
DRIVE_SERVICE_ACCOUNT_FILE=./secrets/drive-sa.json
DRIVE_WATCH_FOLDER_ID=REPLACE_ME
DRIVE_OUTPUT_ROOT_FOLDER_ID=REPLACE_ME
